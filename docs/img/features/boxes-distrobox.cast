[0.216, "o", "\u001b[1;36m$\u001b[0m nixarchy box templates\r\n"]
[1.224, "o", "Templates:\r\n"]
[0.000, "o", "  archlinux  Arch Linux\r\n               distrobox's own default base image. AUR packages, and Arch-only tooling nixpkgs does not carry.\r\n"]
[0.000, "o", "  debian     Debian\r\n               A .deb/apt userland -- AUR's opposite number. Software packaged for Debian and nothing else.\r\n"]
[0.000, "o", "\r\n  nixarchy box create <name> --template <t>\r\n"]
[0.001, "o", "\r\n"]
[1.807, "o", "\u001b[1;36m$\u001b[0m nixarchy box list\r\n"]
