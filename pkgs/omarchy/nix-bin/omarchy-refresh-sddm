#!/bin/bash

# omarchy:summary=Refresh the SDDM login theme from the current Omarchy theme

# The greeter theme ships in the package; only its colours and wallpaper
# follow the Omarchy theme, through nixarchy-greeter-sync.
dir=/var/lib/nixarchy-greeter

if ! systemctl cat nixarchy-greeter-publish.path >/dev/null 2>&1 ||
  ! command -v nixarchy-greeter-sync >/dev/null; then
  echo "The login screen does not follow the theme: set programs.nixarchy.greeterThemeUser."
  exit 0
fi

if [ ! -w "$dir/inbox" ]; then
  owner=$(stat -c %U "$dir/inbox" 2>/dev/null || echo "the configured user")
  echo "Only $owner can publish the login theme."
  exit 1
fi
if ! nixarchy-greeter-sync; then
  echo "Not published (see journalctl -u nixarchy-greeter-publish)."
  exit 1
fi
if ! request=$(cat "$dir/inbox/ready") || [ -z "$request" ]; then
  echo "Not published (see journalctl -u nixarchy-greeter-publish)."
  exit 1
fi

for _ in $(seq 120); do
  if [ "$(cat "$dir/out/current/request" 2>/dev/null)" = "$request" ]; then
    if theme=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null) && [ -n "$theme" ]; then
      echo "The next login screen uses $theme."
      exit 0
    fi
    break
  fi
  sleep 0.5
done
echo "Not published (see journalctl -u nixarchy-greeter-publish)."
