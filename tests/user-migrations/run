run_port
cfg=$XDG_CONFIG_HOME/omarchy/shell.json
jq '.bar.layout |= with_entries(.value |= map(select(.id != "omarchy.elsewhen")))' "$cfg" > "$cfg.tmp"
mv "$cfg.tmp" "$cfg"
: > "$HOME/ipc.log"
run_port
jq -e '[.bar.layout[]?[]? | .id] | index("omarchy.elsewhen") == null' "$cfg" >/dev/null || fail 'e: Elsewhen restored despite marker'
[[ ! -s $HOME/ipc.log ]] || fail 'e: second run made IPC calls'

case=f
setup f "$fixture_a"
STUB_NOWRITE=1 run_port
assert_markers 0
[[ -s $HOME/journal.log ]] || fail 'f: missing journal line'
run_port
assert_markers 3
normalise "$XDG_CONFIG_HOME/omarchy/shell.json" "$work/f.actual.json"
diff -u "$EXPECTED_A" "$work/f.actual.json" || fail 'f: recovery differs from a'

case=g
