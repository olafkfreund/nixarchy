[0.001, "o", "installer # nixarchy-install: the live store cannot hold what this install must fetch.\r\n"]
[0.000, "o", "installer # \r\n"]
[0.000, "o", "installer #   needs : 14G unpacked\r\n"]
[0.001, "o", "installer #   free  : 3.1G on overlay\r\n"]
[0.000, "o", "installer # \r\n"]
[0.001, "o", "installer #   On a live ISO this is a RAM-backed overlay, sized at half the\r\n"]
[0.000, "o", "installer #   machine's memory. It is not the disk you are installing to, which\r\n"]
[0.001, "o", "installer #   has room -- so more RAM, or a machine with more, is what changes it.\r\n"]
[0.000, "o", "installer # \r\n"]
[0.002, "o", "installer #   Building into the target store instead, which has the room. This is\r\n"]
[0.001, "o", "installer #   slower -- every path is written to the disk as it is produced rather\r\n"]
[0.001, "o", "installer #   than copied there at the end -- and it is not a failure.\r\n"]
[0.000, "o", "installer # \r\n"]
[0.000, "o", "installer #   This image downloads the desktop as it installs, so a fetch this\r\n"]
[0.001, "o", "installer #   size is expected and is not a fault.\r\n"]
