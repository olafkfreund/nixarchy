#!/usr/bin/env bash

# nixarchy:new
# omarchy:summary=Put this machine's NixOS configuration in a git repository, with a remote and CI.
# omarchy:args=[--check] [--force]
# omarchy:examples=nixarchy config repo

# The installer leaves /etc/nixos as a git repository with one staged tree and
# no commit -- deliberately: `git commit` needs an identity, and choosing the
# user's is not an installer's business (installer/install.sh, install_flake_dir).
#
# So the gap this closes is not "get the config into git". It is that the
# machine's entire definition exists in one never-committed tree on one disk,
# with no history and no copy anywhere else. A reinstall loses it.
#
# Everything here is idempotent and re-runnable. Each step looks at what is
# already true and skips itself, so a user who has done half of this by hand
# gets the other half rather than an argument.

set -uo pipefail

FLAKE=${NIXARCHY_FLAKE:-/etc/nixos}
DONE_MARKER=config-repo

check_only=false
force=false
while (($#)); do
  case "$1" in
    --check) check_only=true; shift ;;
    --force) force=true; shift ;;
    -h | --help)
      echo "Usage: nixarchy-config-repo [--check] [--force]"
      echo "  --check  exit 0 if the nudge should be shown, 1 otherwise. Prints nothing."
      echo "  --force  run even if already marked done."
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# /etc/nixos is root-owned (installer/install.sh leaves it that way on purpose),
# which splits every git call in two.
#
# Reads work as the user, but only once git is told the repository is not theirs
# -- without safe.directory it refuses with "dubious ownership" and the message
# does not name the fix.
#
# Writes need root, and root has no user.name/user.email of its own, so the
# identity is passed in from the user's global config on each commit. Doing it
# this way rather than setting a root identity keeps the config where the user
# can see and change it.
GIT_COMMON=(-c "safe.directory=$FLAKE" -C "$FLAKE")
# Resolved once, and passed to sudo as a path: sudo runs a binary and cannot
# see the `git` function below, so naming it here is what makes that explicit
# rather than a coincidence of how PATH happens to resolve under sudo.
GIT_BIN=$(command -v git)
git() { command git "${GIT_COMMON[@]}" "$@"; }
wgit() { sudo "$GIT_BIN" "${GIT_COMMON[@]}" "$@"; }
wcommit() {
  wgit -c "user.name=$(command git config --global user.name)" \
       -c "user.email=$(command git config --global user.email)" \
       commit -qm "$1"
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

has_repo()     { git rev-parse --git-dir &>/dev/null; }
has_commits()  { git rev-parse HEAD &>/dev/null; }
has_remote()   { [[ -n $(git remote 2>/dev/null) ]]; }
has_identity() { [[ -n $(git config user.email 2>/dev/null) ]]; }

# "Already handled, leave it alone." A config with commits AND a remote is
# someone's working setup; there is nothing here they have not already done,
# and nagging them about it is the fastest way to teach people to dismiss
# Nixarchy's notifications without reading them.
fully_set_up() { has_repo && has_commits && has_remote; }

# The agent gate.
#
# The point of waiting is ordering, not permission: the skills that explain a
# NixOS config are worth a great deal during this, and an agent that has been
# chosen but never signed in cannot answer anything. Omarchy ships with no
# default agent on purpose, so "unset" is the normal state of a machine whose
# owner has not finished setting up -- exactly who should not be interrupted.
#
# Deliberately permissive at the last step: an agent whose credential path this
# does not know is treated as signed in. Being one boot early is a much smaller
# failure than never showing at all, which is what a strict check would do the
# moment an agent moves its credential file.
agent_ready() {
  local agent creds
  agent=$(omarchy-default-agent 2>/dev/null) || return 1
  [[ -n $agent ]] || return 1
  command -v "$agent" &>/dev/null || return 1

  case "$agent" in
    claude)   creds=("$HOME/.claude/.credentials.json" "$HOME/.claude.json") ;;
    codex)    creds=("$HOME/.codex/auth.json") ;;
    opencode) creds=("$HOME/.local/share/opencode/auth.json" "$HOME/.config/opencode/auth.json") ;;
    gemini)   creds=("$HOME/.gemini/oauth_creds.json") ;;
    copilot)  creds=("$HOME/.config/github-copilot") ;;
    *)        return 0 ;;
  esac

  local c
  for c in "${creds[@]}"; do
    [[ -e $c ]] && return 0
  done
  return 1
}

# --check: should the post-boot hook nudge? Silent; the exit code is the answer.
if [[ $check_only == true ]]; then
  omarchy-done check "$DONE_MARKER" && exit 1

  # Nothing left to do -- mark it done so this never asks again. A machine that
  # arrived already in git should cost its owner zero notifications.
  if fully_set_up; then
    omarchy-done mark "$DONE_MARKER"
    exit 1
  fi

  agent_ready || exit 1
  exit 0
fi

if [[ $force == false ]] && omarchy-done check "$DONE_MARKER"; then
  echo "Already set up. Re-run with --force to go through it again."
  exit 0
fi

# ---------------------------------------------------------------------------
# UI helpers. The floating-terminal wrapper draws the logo and exports the
# theme's gum colours, so this only has to say things.
# ---------------------------------------------------------------------------

say()  { echo -e "$1"; }
step() { echo -e "\n\033[1;32m▸\033[0m \033[1m$1\033[0m"; }
warn() { echo -e "\n\033[1;33m!\033[0m $1"; }
fail() { echo -e "\n\033[1;31m✗\033[0m $1" >&2; }
ok()   { echo -e "  \033[32m✓\033[0m $1"; }

# gum's interrupt is exit 130, which the presentation wrapper reads as "user
# quit" and skips its done screen. Preserve it rather than treating a quit as a
# no.
abort_on_quit() { (($1 == 130)) && { echo; exit 130; }; }

# gh is not in the closure. It is a big dependency for something most people run
# once, so it is fetched on demand -- the first call takes a moment and then it
# is in the store like anything else.
gh() { nix --extra-experimental-features "nix-command flakes" shell nixpkgs#gh -c gh "$@"; }
glab() { nix --extra-experimental-features "nix-command flakes" shell nixpkgs#glab -c glab "$@"; }

# ---------------------------------------------------------------------------
# 0. Where are we, and what is already true
# ---------------------------------------------------------------------------

if [[ ! -d $FLAKE ]]; then
  fail "No configuration directory at $FLAKE."
  say  "Set programs.nixarchy.flake, or export NIXARCHY_FLAKE, to point at it."
  exit 1
fi

say "\033[1mYour NixOS configuration\033[0m"
say "\n  $FLAKE"
say "\nEverything this machine is -- packages, services, keyboard layout,"
say "every choice you have made -- is described by the files in that one"
say "directory. Rebuild from them on another disk and you get this machine"
say "back. Lose them and no amount of remembering brings it back."

if ! has_repo; then
  step "Creating a git repository"
  wgit init -q && wgit add -A && ok "repository created"
fi

if fully_set_up; then
  say "\n\033[32mAlready committed and pushed to a remote.\033[0m Nothing to do here."
  git log --oneline -3 | sed 's/^/  /'
  say "\n  remote: $(git remote get-url "$(git remote | head -1)" 2>/dev/null)"
  omarchy-done mark "$DONE_MARKER"
  exit 0
fi

say ""
if has_commits; then
  ok "$(git rev-list --count HEAD) commits"
else
  warn "Never committed. The tree is staged and has no history."
fi
if has_remote; then
  ok "remote: $(git remote get-url "$(git remote | head -1)")"
else
  warn "No remote. This exists on one disk only."
fi

gum confirm "Set up a backup for it now?"
rc=$?
if ((rc != 0)); then
  abort_on_quit $rc
  say "\nLeaving it as it is. Run \033[1mnixarchy config repo\033[0m whenever you want to."

  # Only a deliberate "no" silences this for good. gum exits 1 for No and
  # something else for a failure it could not even ask through -- with no
  # terminal, say -- and treating that as "never ask again" would retire the
  # nudge on the strength of a question the user never saw.
  gum confirm "Ask again on a future boot?"
  (($? == 1)) && omarchy-done mark "$DONE_MARKER"
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. Identity
# ---------------------------------------------------------------------------

if ! has_identity; then
  step "Who is making these commits?"
  say "  git records a name and address on every commit. They are not verified"
  say "  and are visible to anyone who can read the repository.\n"

  name=$(gum input --prompt "Name  > " --placeholder "$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)")
  abort_on_quit $?
  email=$(gum input --prompt "Email > " --placeholder "you@example.com")
  abort_on_quit $?

  [[ -z $name || -z $email ]] && { fail "Both are needed to commit."; exit 1; }

  # --global, not on the repo: /etc/nixos is root-owned, so a repo-local
  # identity would have to be written as root and would not follow the user to
  # their own projects, which is where they will next want it.
  command git config --global user.name "$name"
  command git config --global user.email "$email"
  ok "identity set globally"
fi

# ---------------------------------------------------------------------------
# 2. .gitignore
# ---------------------------------------------------------------------------

if [[ ! -f $FLAKE/.gitignore ]]; then
  step "Writing a .gitignore"
  say "  Build outputs and plaintext secrets should not be committed. Encrypted"
  say "  secrets (.age, sops files) should be -- that is the point of them.\n"

  sudo tee "$FLAKE/.gitignore" >/dev/null <<'GITIGNORE'
# Build outputs. `nix build` drops these symlinks into the flake directory;
# they point into the store and mean nothing on another machine.
result
result-*

# Direnv / editor state
.direnv/
.envrc.local
*.swp
.DS_Store

# Plaintext secrets. Anything encrypted -- *.age, sops-managed YAML -- is
# meant to be committed and is deliberately NOT ignored here.
*.key
*.pem
id_rsa
id_ed25519
.env
.env.*
secrets.txt
secrets/*.txt
GITIGNORE
  ok ".gitignore written"
fi

# ---------------------------------------------------------------------------
# 3. Secret scan. Before the first commit, and before any choice about
#    visibility -- a tool that helps you publish your configuration must not
#    help you publish your password.
# ---------------------------------------------------------------------------

step "Checking for secrets in the configuration"

hits=$(grep -rInE '(password|passwd|secret|token|apikey|api_key|accessKey)[[:space:]]*=[[:space:]]*"[^"]{6,}"' \
  --include='*.nix' "$FLAKE" 2>/dev/null \
  | grep -vE 'File[[:space:]]*=|hashedPasswordFile|\.path|placeholder|config\.(age|sops)' \
  | head -20)

if [[ -n $hits ]]; then
  warn "Found values that look like secrets written directly into Nix files:\n"
  echo "$hits" | sed 's|'"$FLAKE"'/||' | sed 's/^/    /'
  say "\n  /nix/store is world-readable and every build input ends up in it, so"
  say "  these are already readable by any user on this machine. Committing"
  say "  them adds a permanent copy in the history, which a later edit does not"
  say "  remove. Ask your agent about the \033[1mnixos-secrets\033[0m skill --"
  say "  agenix and sops-nix exist for exactly this.\n"

  gum confirm --default=false "Commit anyway?" || { abort_on_quit $?
    say "\nStopping here. Nothing was committed. Fix those, then re-run"
    say "\033[1mnixarchy config repo\033[0m."
    exit 0; }
else
  ok "nothing obvious found"
fi

# ---------------------------------------------------------------------------
# 4. First commit
# ---------------------------------------------------------------------------

if ! has_commits; then
  step "Committing"
  wgit add -A
  if wcommit "Initial Nixarchy configuration for $(hostname)"; then
    ok "committed"
  else
    fail "Commit failed. Nothing else here will work until it succeeds."
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 5. Remote
# ---------------------------------------------------------------------------

if ! has_remote; then
  step "Where should the backup live?"

  provider=$(gum choose --header "" \
    "GitHub" \
    "GitLab" \
    "Somewhere else (I have a URL)" \
    "Nowhere for now")
  abort_on_quit $?

  case "$provider" in
    "Nowhere for now")
      say "\n  Committed locally. That is history and rollback, but not a backup --"
      say "  it is still on one disk. Re-run this any time to add a remote."
      omarchy-done mark "$DONE_MARKER"
      exit 0
      ;;

    "Somewhere else (I have a URL)")
      say "\n  Create an empty repository on your host -- Codeberg, a self-hosted"
      say "  Forgejo or Gitea, anything that speaks git -- and paste its URL.\n"
      url=$(gum input --prompt "URL > " --placeholder "git@codeberg.org:you/nixos-config.git")
      abort_on_quit $?
      [[ -z $url ]] && { say "\nNo URL given."; exit 0; }
      wgit remote add origin "$url"
      ok "remote added"
      ;;

    GitHub | GitLab)
      say "\n  \033[1mPrivate or public?\033[0m"
      say "  A NixOS configuration names your hostname, your username, your"
      say "  network layout and your SSH public keys. None of that is a secret"
      say "  on its own, and plenty of people publish theirs on purpose -- but"
      say "  it should be a decision, not a default.\n"

      visibility=$(gum choose --header "" \
        "Private  (recommended)" \
        "Public   (share it deliberately)")
      abort_on_quit $?
      vis_flag=$([[ $visibility == Private* ]] && echo "--private" || echo "--public")

      reponame=$(gum input --prompt "Repository name > " --value "nixos-config")
      abort_on_quit $?
      [[ -z $reponame ]] && { say "\nNo name given."; exit 0; }

      say "\n  Fetching the CLI (first run only)..."
      if [[ $provider == GitHub ]]; then
        if ! gh auth status &>/dev/null; then
          say "\n  Signing in to GitHub. This opens a browser."
          gh auth login -p ssh -h github.com -w || { fail "Sign-in failed."; exit 1; }
        fi
        # -C over --source: --source insists on running inside the repo, and
        # this one is root-owned.
        gh repo create "$reponame" "$vis_flag" --disable-wiki || { fail "Could not create the repository."; exit 1; }
        owner=$(gh api user --jq .login)
        url="git@github.com:$owner/$reponame.git"
      else
        if ! glab auth status &>/dev/null; then
          say "\n  Signing in to GitLab. This opens a browser."
          glab auth login || { fail "Sign-in failed."; exit 1; }
        fi
        glab repo create "$reponame" "$vis_flag" || { fail "Could not create the repository."; exit 1; }
        owner=$(glab api user --method GET 2>/dev/null | sed -n 's/.*"username":"\([^"]*\)".*/\1/p')
        url="git@gitlab.com:$owner/$reponame.git"
      fi
      wgit remote add origin "$url"
      ok "remote added: $url"
      ;;
  esac
fi

# ---------------------------------------------------------------------------
# 6. CI
# ---------------------------------------------------------------------------

remote_url=$(git remote get-url origin 2>/dev/null)

ci_file=""
case "$remote_url" in
  *github.com*) ci_file=".github/workflows/check.yml" ;;
  *gitlab*)     ci_file=".gitlab-ci.yml" ;;
esac

if [[ -n $ci_file && ! -f $FLAKE/$ci_file ]]; then
  step "Checking the configuration on every push?"
  say "  Evaluates the flake and every host it defines, so a typo or a renamed"
  say "  option is caught by a push instead of by a rebuild that fails at the"
  say "  console.\n"
  say "  Evaluation only -- it does not build the system. A full build on a"
  say "  free runner takes hours and often runs out of disk, and eval catches"
  say "  the overwhelming majority of what actually breaks.\n"

  if gum confirm "Add it?"; then
    sudo mkdir -p "$FLAKE/$(dirname "$ci_file")"
    if [[ $ci_file == .github* ]]; then
      sudo tee "$FLAKE/$ci_file" >/dev/null <<'GHA'
name: check

on:
  push:
  pull_request:
  schedule:
    - cron: "0 6 * * 1"   # Monday, so a broken nixpkgs input is noticed early

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: DeterminateSystems/nix-installer-action@main
      - uses: DeterminateSystems/magic-nix-cache-action@main

      # Evaluates every output the flake defines, including each
      # nixosConfiguration. Catches renamed options, type errors and typos.
      # It does NOT build the system: that needs hours and more disk than a
      # free runner has.
      - name: nix flake check
        run: nix flake check --all-systems --no-build

      # Names every host so a failure says which one, rather than failing
      # somewhere inside a combined evaluation.
      - name: Evaluate each host
        run: |
          hosts=$(nix eval --json --apply builtins.attrNames \
                    .#nixosConfigurations 2>/dev/null | tr -d '[]"' | tr ',' ' ')
          for h in $hosts; do
            echo "::group::$h"
            nix eval --raw ".#nixosConfigurations.$h.config.system.build.toplevel.drvPath"
            echo
            echo "::endgroup::"
          done
GHA
    else
      sudo tee "$FLAKE/$ci_file" >/dev/null <<'GLCI'
# Evaluation only: `nix flake check --no-build` catches renamed options, type
# errors and typos without building the system, which needs hours and more
# disk than a shared runner has.
check:
  image: nixos/nix:latest
  variables:
    NIX_CONFIG: "experimental-features = nix-command flakes"
  script:
    - nix flake check --all-systems --no-build
    - |
      hosts=$(nix eval --json --apply builtins.attrNames .#nixosConfigurations | tr -d '[]"' | tr ',' ' ')
      for h in $hosts; do
        echo "--- $h"
        nix eval --raw ".#nixosConfigurations.$h.config.system.build.toplevel.drvPath"
        echo
      done
  rules:
    - if: $CI_PIPELINE_SOURCE == "push"
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
GLCI
    fi
    wgit add -A
    wcommit "Check the configuration on every push"
    ok "$ci_file added"
  fi
fi

# ---------------------------------------------------------------------------
# 7. Push
# ---------------------------------------------------------------------------

step "Pushing"

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo main)
if wgit push -u origin "$branch" 2>&1 | sed 's/^/  /'; then
  ok "pushed to $(git remote get-url origin)"
  omarchy-done mark "$DONE_MARKER"

  say "\n\033[1mDone.\033[0m Your configuration has a history and a copy that is not"
  say "on this disk."
  say "\nFrom here on, after you change something:"
  say "\n    \033[1mcd $FLAKE\033[0m"
  say "    \033[1msudo git add -A && sudo git commit -m 'what changed'\033[0m"
  say "    \033[1msudo git push\033[0m"
  say "\nCommit \033[1mbefore\033[0m you rebuild, not after -- a flake in a git"
  say "repository cannot see untracked files, so a new .nix file that has not"
  say "been added is invisible to the build. That is the single most common"
  say "reason a change appears to do nothing."
else
  fail "Push failed. The commit is safe locally; nothing was lost."
  say  "  Fix the remote or your SSH key and re-run: \033[1mnixarchy config repo\033[0m"
  exit 1
fi
