[0.301, "o", "\u001b[1;36m$\u001b[0m nixarchy vm templates\r\n"]
[1.137, "o", "Templates:\r\n"]
[0.000, "o", "  persistent Persistent\r\n               Shell, plus /home on a 10 GiB volume. The volume goes when the VM does ('nixarchy vm rm'); the root filesystem is still thrown away every boot.\r\n"]
[0.000, "o", "  podman     Podman\r\n               Rootless-capable podman with Docker compatibility. /var/lib/containers is a 20 GiB volume that survives a restart; the rest of the root filesystem does not.\r\n  python     Python\r\n               python3 and uv, 3 GiB of RAM. Ephemeral like Shell -- run 'uv venv /mnt/host/.venv' if the venv should outlive the VM.\r\n  shell      Shell\r\n"]
[0.000, "o", "               A bare NixOS shell with nothing added beyond modules/microvm/guest.nix -- the fastest way to a throwaway prompt, and the template every other one starts from.\r\n"]
[0.001, "o", "\r\n"]
[1.614, "o", "\u001b[1;36m$\u001b[0m nixarchy vm list\r\n"]
[1.148, "o", "No VMs yet. 'nixarchy vm create <name>' to make one.\r\n"]
[0.001, "o", "\r\n"]
[1.609, "o", "\u001b[1;36m$\u001b[0m nixarchy vm create demo --template shell\r\n"]
[1.176, "o", "Created 'demo' from the 'shell' template.\r\n  nixarchy vm run demo\r\n"]
[0.001, "o", "\r\n"]
[1.614, "o", "\u001b[1;36m$\u001b[0m nixarchy vm list\r\n"]
[1.142, "o", "VMs:\r\n"]
[0.009, "o", "  demo             template=shell      stopped\r\n"]
[0.000, "o", "\r\n"]
[1.608, "o", "\u001b[1;36m$\u001b[0m id -un && id -u\r\n"]
[1.130, "o", "omarchy\r\n"]
[0.004, "o", "1000\r\n"]
[0.001, "o", "\r\n"]
[1.606, "o", "\u001b[1;36m$\u001b[0m nixarchy vm rm demo\r\n"]
[1.137, "o", "Removed 'demo'.\r\n"]
