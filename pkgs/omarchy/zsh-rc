# Omarchy's shell for zsh.
#
# Upstream ships a bash rc chain and nothing else, so a zsh user got none of
# it: not the aliases the manual documents, not compress/dip/hdl/iso2sd, and
# not the tmux layout functions tdl/tds/tsl. That is most of the "Shell Tools"
# and "Shell Functions" pages missing for anyone whose login shell is zsh.
#
# Three of the five files in that chain are plain POSIX-ish shell and were
# checked to source *and run* identically under zsh -- compress produces the
# same output, tdl defines the same function. They are sourced as-is, so they
# keep tracking upstream rather than being forked.
#
# The other two are genuinely bash: `shell` uses shopt and BASH_COMPLETION
# internals, `init` asks starship and zoxide for *bash* integration and
# loads fzf's bash key bindings. Those are reimplemented here against the same
# tools' zsh support -- which is the same feature, not an approximation.
#
# Deliberately not carried over:
#   completions  -- `complete -F`, bash's completion system. zsh has compinit,
#                   and the two do not mix.
#   inputrc      -- readline. zsh uses ZLE and reads none of it.
#
# Anyone wanting either has zsh's own, which is better than a broken port.

: "${OMARCHY_PATH:=/usr/share/omarchy}"

# Portable as-is: verified to source and behave the same under both shells.
source "$OMARCHY_PATH/default/bash/envs"
source "$OMARCHY_PATH/default/bash/aliases"
source "$OMARCHY_PATH/default/bash/functions"

# --- the bash-only half, in zsh -------------------------------------------

# default/bash/shell. Same intent: keep history, share it, and stop hashing
# commands so newly installed tools are found without restarting the shell.
HISTSIZE=32768
SAVEHIST=$HISTSIZE
setopt APPEND_HISTORY INC_APPEND_HISTORY
setopt HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS
unsetopt HASH_CMDS

# default/bash/init: add agent dispatch, then ask each tool for zsh support.
# Tool guards match upstream: only when present, and interactively for the prompt.
if [[ :$PATH: != *":$OMARCHY_PATH/agent-dispatch:"* ]]; then
  PATH="$OMARCHY_PATH/agent-dispatch:$PATH"
fi

if [[ -o interactive ]] && [[ ${TERM:-} != "dumb" ]] && command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi

if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# `try` shells out to $SHELL, so it gets zsh's own init rather than bash's.
if command -v try &>/dev/null; then
  try() {
    unfunction try
    eval "$(SHELL=$(command -v zsh) command try init ~/Work/tries)"
    try "$@"
  }
fi

# fzf ships zsh bindings the same way it ships bash ones. NixOS installs them
# under the package rather than /usr/share, so ask fzf where it lives.
#
# Behind a tty check because both files drive ZLE, and zsh -i without a
# terminal -- ssh with no pty, a script, a test harness -- answers each of
# them with "can't change option: zle" before doing anything. `[[ -o zle ]]`
# looks like the right guard and is not: the option is set in both cases, it
# is the terminal that is missing.
if command -v fzf &>/dev/null && [[ -t 0 ]]; then
  fzf_share=${FZF_BASE:-$(dirname "$(dirname "$(readlink -f "$(command -v fzf)")")")/share/fzf}
  [[ -f $fzf_share/completion.zsh ]] && source "$fzf_share/completion.zsh"
  [[ -f $fzf_share/key-bindings.zsh ]] && source "$fzf_share/key-bindings.zsh"
fi
