#!/usr/bin/env bash

# omarchy:summary=Set and launch the default coding agent (declaratively, on NixOS).
# omarchy:args=[claude|codex|opencode|crush|gemini|copilot|grok|antigravity|pi|omp]
# omarchy:examples=omarchy default agent | omarchy default agent codex | omarchy default agent claude

# Upstream installs the agent with `mise use -g`, which downloads a prebuilt
# binary into ~/.local/share/mise. On NixOS that is wrong three times over, and
# every one of them was observed on a real machine:
#
#   1. It is imperative. Nothing records it, a reinstall does not reproduce it,
#      and it is invisible to anyone reading the configuration -- the exact
#      failure omarchy-pkg-add was replaced to stop.
#
#   2. mise activates in the SHELL rc, so its shims reach an interactive
#      terminal and nothing else. The menu launches an agent through
#      `bash -c` inside a floating terminal, which sources no rc, so a
#      perfectly installed agent reported
#
#        claude is not installed. Choose an installed agent with: ...
#
#      while `claude --version` printed 2.1.251 one shell over.
#
#   3. mise's npm backend needs node, which is not in this closure, so an
#      npm-only agent could not install at all:
#
#        sh: line 1: node: command not found
#
# nixpkgs has seven of these agents, and each one's meta.mainProgram is exactly
# the command omarchy-agent looks for -- so routing them through the declarative
# path fixes all three at once. environment.systemPackages lands in
# /run/current-system/sw/bin, which is on every PATH including the compositor's,
# with no shell rc and no shims involved.
#
# The two that nixpkgs has no package for still go through mise, because a
# broken menu entry is worse than an imperative one. They say so out loud.

set -uo pipefail

agent_file="$HOME/.config/omarchy/defaults/agent"

# agent id -> nixpkgs attribute. The command each installs is meta.mainProgram
# and is already the id, which is why nothing here has to map names twice.
attr_for() {
  case "$1" in
    claude)   echo claude-code ;;
    codex)    echo codex ;;
    opencode) echo opencode ;;
    crush)    echo crush ;;
    gemini)   echo gemini-cli ;;
    copilot)  echo github-copilot-cli ;;
    grok)     echo grok-cli ;;
    openclaw) echo openclaw ;;
    *)        echo "" ;;
  esac
}

# Not in nixpkgs at the time of writing. mise has both, as `aqua:` backends --
# prebuilt binaries rather than npm, so they install without node.
mise_pkg_for() {
  case "$1" in
    pi)          echo pi ;;
    omp)         echo "github:can1357/oh-my-pi" ;;
    antigravity) echo agy ;;
    *)           echo "" ;;
  esac
}

if [[ ${1:-} == "--install" ]]; then
  # Upstream re-execs itself with this after opening a floating terminal, so a
  # long mise download has somewhere to draw. The declarative route does its
  # own waiting inside nixarchy-apply; the flag is accepted so an upstream
  # caller does not error, and otherwise ignored.
  shift
fi

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  # Silent when unset rather than defaulting: Omarchy picks no agent for you, so
  # the menu leaves every entry unchecked until one is chosen.
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

case "$1" in
pi) agent="pi"; name="Pi" ;;
omp | oh-my-pi) agent="omp"; name="Oh My Pi" ;;
opencode | open-code) agent="opencode"; name="OpenCode" ;;
claude | claude-code) agent="claude"; name="Claude Code" ;;
codex) agent="codex"; name="Codex" ;;
crush) agent="crush"; name="Crush" ;;
grok) agent="grok"; name="Grok" ;;
antigravity | agy) agent="antigravity"; name="Antigravity" ;;
# Google deprecated gemini-cli in favour of Antigravity, but nixpkgs still has
# a maintained gemini-cli and people still ask for it by name, so both stay.
gemini | gemini-cli) agent="gemini"; name="Gemini" ;;
copilot | github-copilot) agent="copilot"; name="GitHub Copilot" ;;
# The menu has rows for these four and the case did not, so each printed a usage
# line and exited 1 -- into a detached terminal nobody sees (#949). openclaw is
# in nixpkgs; the other three are not, and get the third route below.
cursor-agent | cursor) agent="cursor-agent"; name="Cursor Agent" ;;
hermes) agent="hermes"; name="Hermes" ;;
muse) agent="muse"; name="Muse" ;;
openclaw) agent="openclaw"; name="OpenClaw" ;;
*)
  echo "Usage: omarchy-default-agent <claude|codex|opencode|crush|gemini|copilot|grok|antigravity|pi|omp|cursor-agent|hermes|muse|openclaw>" >&2
  exit 1
  ;;
esac

record() {
  mkdir -p "$(dirname "$agent_file")"
  printf '%s\n' "$agent" >"$agent_file"
}

# gum confirm has three answers, not two: 0 is yes, 1 is no, 130 is a quit --
# and anything else means it could not ask at all. The usual `gum confirm ... ||`
# collapses the last two into "no", which is how an offer to build silently did
# nothing at all when there was no terminal to draw on.
#
# So the caller says what "could not ask" should mean, rather than inheriting
# whichever answer the shell's error convention happens to match.
confirm() { # confirm <prompt> <yes|no, when it cannot be asked>
  local prompt=$1 fallback=$2 rc

  if [ -t 0 ] && [ -t 1 ] && command -v gum &>/dev/null; then
    gum confirm "$prompt"
    rc=$?
    case $rc in
      0) return 0 ;;
      1) return 1 ;;
      130) exit 130 ;; # a quit is a quit; the presentation wrapper reads this
      *) ;;            # could not ask -- fall through
    esac
  fi

  [ "$fallback" = yes ]
}

# The command each agent installs is its own id. Checked against PATH rather
# than against a package database: what matters is whether omarchy-agent will
# find it, and that is the same question.
if command -v "$agent" &>/dev/null; then
  record
  exec omarchy-agent
fi

attr=$(attr_for "$agent")

if [[ -n $attr ]]; then
  # Recorded before the rebuild, not after. The selection is the user's answer
  # to "which agent", and it is still their answer if they close the terminal
  # while nixos-rebuild is running -- losing it would mean asking twice for the
  # same decision.
  record

  echo
  echo "$name is not installed."
  echo
  echo "Adding it to your configuration as ${attr}, so it is still here after"
  echo "the next rebuild and on the next machine you install from this flake."
  echo

  if ! nixarchy-pkg-add "$attr"; then
    echo >&2
    echo "Could not add $attr to ~/.config/nixarchy/apps.nix." >&2
    echo "Add it by hand and run: nixarchy apply" >&2
    exit 1
  fi

  echo
  echo "Building it now. This takes a few minutes the first time, and asks for"
  echo "your password to rebuild the system."
  echo

  # Run, not offered. Choosing an agent and getting one used to be the same act
  # -- upstream installs it there and then -- and splitting them is what left a
  # ticked menu entry beside a `claude: command not found`. Declining is still
  # possible, and says what it costs.
  #
  # "yes" when it cannot ask: the menu's own launcher has a terminal, so the
  # cases that cannot are scripts and tests, where finishing the job the caller
  # asked for beats stopping half way through it.
  if confirm "Build it now?" yes; then
    exec nixarchy-apply
  fi

  echo "Not building. $name is in your configuration but not installed yet."
  echo "Run 'nixarchy apply' when you are ready."
  exit 0
fi

# Packaged elsewhere, and named rather than carried (#949).
#
# numtide/llm-agents.nix has all three. It is NOT a nixarchy input and must not
# become one: lib.inputSources collects every flake's outPath and every input of
# theirs transitively, and installer/cd.nix and installer/host.nix both carry
# that onto the offline ISO and every installed host. llm-agents.nix pins its
# own nixpkgs-unstable and documents being tested only against it, so `follows`
# is not safely available -- one nixpkgs source tree measures about 486 MB, and
# checks.iso-budget exists to refuse it.
#
# The reason is printed, not just recorded here: without it the next person
# reads "packaged over there" as "so add the input".
elsewhere_attr_for() {
  case "$1" in
    cursor-agent) echo cursor-agent ;;
    hermes)       echo hermes-agent ;;
    muse)         echo muse-code ;;
    *)            echo "" ;;
  esac
}

elsewhere=$(elsewhere_attr_for "$agent")
if [[ -n $elsewhere ]]; then
  # Recorded before the advice, like the nixpkgs path above: the selection is
  # the user's answer to "which agent", and it stays their answer whether or
  # not they go and install it.
  record

  echo
  echo "$name is recorded as your default agent, and is not installed."
  echo
  echo "It is not in nixpkgs. numtide/llm-agents.nix packages it as"
  echo "$elsewhere. Add that flake as an input and the package to your"
  echo "configuration."
  echo
  echo "nixarchy does not carry it: llm-agents.nix pins its own nixpkgs, and"
  echo "nixarchy puts every input's source tree on the ISO and on every"
  echo "installed machine -- about 486 MB, for one optional agent."
  if [[ $agent == cursor-agent ]]; then
    echo
    echo "Note: cursor-agent is unfree wherever it comes from, so a machine"
    echo "with nixpkgs.config.allowUnfree = false cannot install it at all."
  fi
  echo
  exit 0
fi

# No nixpkgs package. mise, and honest about what that costs.
mise_pkg=$(mise_pkg_for "$agent")
if [[ -z $mise_pkg ]]; then
  echo "No way to install $name is known." >&2
  exit 1
fi

echo
echo "$name has no nixpkgs package, so it is installed with mise instead."
echo "That is imperative: it lives in ~/.local/share/mise, nothing in your"
echo "configuration records it, and a fresh install of this flake will not"
echo "bring it back."
echo

if ! mise use -g "$mise_pkg"; then
  echo "Could not install $name with mise" >&2
  exit 1
fi

record

# mise activates from the shell rc, which the menu's `bash -c` never sources,
# so the shim has to be found by path rather than by name. Without this the
# install succeeds and the very next line claims the agent is not installed.
shims="$HOME/.local/share/mise/shims"
if [[ -x $shims/$agent ]]; then
  export PATH="$shims:$PATH"
fi

exec omarchy-agent
