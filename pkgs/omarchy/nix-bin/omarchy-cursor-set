#!/usr/bin/env bash

# nixarchy:new
# omarchy:summary=Point the cursor theme at the light or dark half of the current Omarchy theme.
# omarchy:hidden=true

# Omarchy sets a cursor *size* (default/hypr/envs.lua) but never a cursor
# theme, because on Arch one arrives with the desktop packages. NixOS ships
# none, so Hyprland falls back to its own built-in cursor and stays there
# through every theme change.
#
# Bibata has a matched pair -- Ice is white, Classic is black -- so the cursor
# can follow the theme the same way the GTK colour scheme does.
set -euo pipefail

colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
mode=$(omarchy-theme-color --file "$colors" mode 2>/dev/null || echo dark)

if [[ $mode == "light" ]]; then
  theme="Bibata-Modern-Classic" # black, for a light background
else
  theme="Bibata-Modern-Ice" # white, for a dark background
fi

size=${XCURSOR_SIZE:-24}

# GTK and anything else reading the interface schema.
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  gsettings set org.gnome.desktop.interface cursor-theme "$theme" || true
  gsettings set org.gnome.desktop.interface cursor-size "$size" || true
fi

# Hyprland's own pointer, and the environment XWayland clients inherit.
if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
  hyprctl setcursor "$theme" "$size" >/dev/null || true
  hyprctl eval "hl.env(\"XCURSOR_THEME\", \"$theme\")" >/dev/null
fi

echo "$theme"
