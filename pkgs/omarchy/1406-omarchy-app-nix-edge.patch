+## `package.nix`
+
+```nix
+{ lib, stdenv, cmake, qt6 }:
+
+stdenv.mkDerivation {
+  pname = "<name>";
+  version = "0.1.0";
+  src = ./.;
+
+  nativeBuildInputs = [ cmake qt6.wrapQtAppsHook ];
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtmultimedia
+    qt6.qtsvg
+    qt6.qtwayland
+  ];
+  nativeCheckInputs = [ ];
+
+  # The tests, and a build run from the dev shell, are not wrapped, so they find
+  # Qt's QML modules by this path.
+  QML_IMPORT_PATH = lib.concatMapStringsSep ":" (p: "${p}/${qt6.qtbase.qtQmlPrefix}") [
+    qt6.qtdeclarative
+    qt6.qtmultimedia
+  ];
+
+  dontUseCmakeConfigure = true;
+  buildPhase = ''
+    runHook preBuild
+    # The sandbox has no /bin/bash, so the shared script runs through bash.
+    bash bin/build
+    runHook postBuild
+  '';
+  doCheck = true;
+  checkPhase = ''
+    runHook preCheck
+    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure --no-tests=error
+    runHook postCheck
+  '';
+  installPhase = ''
+    runHook preInstall
+    cmake --install build --prefix $out
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "One line on what it does";
+    license = lib.licenses.mit;
+    mainProgram = "<name>";
+  };
+}
+```
+
+If the app shells out to `ffmpeg`, add `ffmpeg` to the arguments and `buildInputs`, and `qtWrapperArgs = [ "--prefix PATH : ${lib.makeBinPath [ ffmpeg ]}" ];` so the dev shell and installed binary find it. The repo should still carry a LICENSE (the MIT text with the user's name and year).
