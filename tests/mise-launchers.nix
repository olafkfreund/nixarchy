{ pkgs, omarchy }:
# The cleanup may delete only byte-identical regular launchers generated by
# Omarchy. Compare the whole fixture tree so an unexpected deletion is visible.
pkgs.runCommand "nixarchy-mise-launchers"
  {
    nativeBuildInputs = [
      pkgs.diffutils
      pkgs.findutils
      pkgs.gawk
      pkgs.gnugrep
    ];
  }
  ''
    set -euo pipefail
    export HOME=$TMPDIR/home
    export XDG_DATA_HOME=$HOME/.local/share
    export XDG_STATE_HOME=$HOME/.local/state
    export XDG_CONFIG_HOME=$HOME/.config
    export XDG_CACHE_HOME=$HOME/.cache
    bin=$HOME/.local/bin
    notice=$XDG_STATE_HOME/nixarchy/mise-notice
    mkdir -p "$bin" "$XDG_DATA_HOME/mise" "$XDG_CONFIG_HOME/mise" "$XDG_CACHE_HOME" "$TMPDIR/hm"

    launcher() {
      case $1 in
        quiet) printf '#!/bin/bash\nexport MISE_MINIMUM_RELEASE_AGE=0\nmise use -g --quiet "%s" || exit 1\nexec mise x "%s" -- "%s" "$@"\n' "$2" "$2" "$3" ;;
        cooldown-export) printf '#!/bin/bash\nexport MISE_MINIMUM_RELEASE_AGE=0\nmise use -g "%s" || exit 1\nexec mise x "%s" -- "%s" "$@"\n' "$2" "$2" "$3" ;;
        bail-on-failure) printf '#!/bin/bash\nmise use -g "%s" || exit 1\nexec mise x "%s" -- "%s" "$@"\n' "$2" "$2" "$3" ;;
        mise-exec) printf '#!/bin/bash\nmise use -g "%s"\nexec mise exec "%s" -- "%s" "$@"\n' "$2" "$2" "$3" ;;
        bare-exec) printf '#!/bin/bash\nmise use -g "%s"\nexec "%s" "$@"\n' "$2" "$3" ;;
      esac
    }
    state() {
      (cd "$TMPDIR" && find home hm \( -type f -o -type l \) -print0 | sort -z) |
        while IFS= read -r -d "" p; do
          if [ -L "$TMPDIR/$p" ]; then
            printf '%s\tL %s\n' "$p" "$(readlink "$TMPDIR/$p")"
          else
            printf '%s\tF %s\n' "$p" "$(sha256sum <"$TMPDIR/$p" | cut -d' ' -f1)"
          fi
        done
    }
    compare() {
      awk -F '\t' 'NR == FNR { b[$1] = $2; next } { a[$1] = $2 }
        END {
          for (p in b) if (!(p in a)) print "D\t" p; else if (b[p] != a[p]) print "C\t" p
          for (p in a) if (!(p in b)) print "A\t" p
        }' "$1" "$2" | sort
    }
    changes() {
      compare "$1" "$2" > delta
      if [ -n "$3" ]; then
        diff -u <(printf '%s\n' "$3" | sort) delta
      else
        [ ! -s delta ]
      fi
    }

    # An empty mise directory alone must not create a notice.
    "${omarchy}/bin/omarchy-mise-unshadow" > empty.log
    [ ! -e "$notice" ]

    for form in quiet cooldown-export bail-on-failure mise-exec bare-exec; do
      ! command -v "$form" >/dev/null
      launcher "$form" "pkg:$form" "$form" > "$bin/$form"
    done
    launcher quiet pkg:changed changed > "$bin/changed"
    printf ' ' >> "$bin/changed"
    launcher quiet pkg:wrong other > "$bin/wrong"
    launcher quiet pkg:linked linked > "$TMPDIR/hm/linked"
    ln -s "$TMPDIR/hm/linked" "$bin/linked"
    printf '#!/bin/bash\necho mine\n' > "$bin/personal"
    printf '#!/bin/bash\neval "$(mise activate zsh)"\n' > "$bin/activation"
    launcher quiet pkg:large large > "$bin/large"
    printf '%1100s' ' ' >> "$bin/large"
    mkdir -p "$XDG_DATA_HOME/mise/installs/node" "$XDG_DATA_HOME/mise/shims"
    printf 'keep\n' > "$XDG_DATA_HOME/mise/shims/node"
    printf 'keep\n' > "$XDG_DATA_HOME/mise/installs/node/version"
    printf 'keep\n' > "$XDG_CONFIG_HOME/mise/config.toml"
    state > before
    "${omarchy}/bin/omarchy-mise-unshadow" > first.log
    state > after
    expected=$(printf 'A\thome/.local/state/nixarchy/mise-notice\n'; for form in quiet cooldown-export bail-on-failure mise-exec bare-exec; do printf 'D\thome/.local/bin/%s\n' "$form"; done)
    changes before after "$expected"
    for form in quiet cooldown-export bail-on-failure mise-exec bare-exec; do
      grep -Fx "omarchy-mise-unshadow: removed $bin/$form" first.log
      grep -Fx "Removed launcher: $bin/$form" "$notice"
    done
    for name in changed wrong activation large; do
      grep -F "$bin/$name" "$notice"
    done
    grep -F 'installs: node' "$notice"
    [ -L "$bin/linked" ] && [ -f "$TMPDIR/hm/linked" ]
    [ -f "$bin/personal" ]

    cp after before
    "${omarchy}/bin/omarchy-mise-unshadow" > second.log
    state > after
    changes before after ''
    [ ! -s second.log ]

    mkdir -p "$TMPDIR/stubs"
    printf '#!%s\nexit 1\n' '${pkgs.runtimeShell}' > "$TMPDIR/stubs/omarchy-notification-send"
    chmod +x "$TMPDIR/stubs/omarchy-notification-send"
    PATH=$TMPDIR/stubs:$PATH "${omarchy}/bin/omarchy-mise-unshadow" --notify
    [ ! -e "$notice.shown" ]
    printf '#!%s\necho sent >> "$TMPDIR/sends"\nexit 0\n' '${pkgs.runtimeShell}' > "$TMPDIR/stubs/omarchy-notification-send"
    PATH=$TMPDIR/stubs:$PATH "${omarchy}/bin/omarchy-mise-unshadow" --notify
    [ -e "$notice.shown" ]
    state > before
    PATH=$TMPDIR/stubs:$PATH "${omarchy}/bin/omarchy-mise-unshadow" --notify
    state > after
    changes before after ''
    [ "$(wc -l < "$TMPDIR/sends")" -eq 1 ]

    launcher quiet pkg:later later > "$bin/later"
    state > before
    "${omarchy}/bin/omarchy-mise-unshadow" > later.log
    state > after
    changes before after "$(printf 'C\thome/.local/state/nixarchy/mise-notice\nD\thome/.local/bin/later\nD\thome/.local/state/nixarchy/mise-notice.shown')"
    grep -Fx "Removed launcher: $bin/later" "$notice"
    grep -Fx "omarchy-mise-unshadow: removed $bin/later" later.log
    [ ! -e "$notice.shown" ]
    touch $out
  ''
