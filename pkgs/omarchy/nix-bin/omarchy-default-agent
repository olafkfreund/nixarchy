#!/usr/bin/env bash

# omarchy:summary=Set and launch the default coding agent (declaratively, on NixOS).
# omarchy:args=[claude|codex|opencode|crush|gemini|copilot|grok|agy|pi|omp|ori|kimi|qwen|dsh|mcode|kiro-cli|freebuff|kilo|devin|amp|commandcode]
# omarchy:examples=omarchy default agent | omarchy default agent codex | omarchy default agent claude

# Upstream installs the agent with `mise use -g`; nixarchy installs nothing that way.
# Each row either adds a nixpkgs package through nixarchy-pkg-add and rebuilds
# (attr_for), or says plainly that nixarchy does not install it and where it is
# packaged (elsewhere_attr_for). Each package's meta.mainProgram is the agent's id,
# which is the command omarchy-agent looks for.

set -uo pipefail

agent_file="$HOME/.config/omarchy/defaults/agent"

# agent id -> nixpkgs attribute. Canonical ids match the installed command;
# gemini is a legacy spelling that now resolves to Antigravity.
attr_for() {
  case "$1" in
    claude)   echo claude-code ;;
    codex)    echo codex ;;
    opencode) echo opencode ;;
    crush)    echo crush ;;
    gemini)   echo antigravity-cli ;;
    copilot)  echo github-copilot-cli ;;
    grok)     echo grok-cli ;;
    openclaw) echo openclaw ;;
    agy)      echo antigravity-cli ;;
    pi)       echo pi-coding-agent ;;
    omp)      echo omp ;;
    cursor-agent) echo cursor-cli ;;
    muse)     echo muse-code ;;
    # Added to quattro's menu by #14040. `amp` in nixpkgs is a text editor;
    # Sourcegraph's agent is amp-cli.
    amp)      echo amp-cli ;;
    qwen)     echo qwen-code ;;
    kilo)     echo kilo ;;
    devin)    echo devin-cli ;;
    dsh)      echo deepseek-harness ;;
    kiro-cli) echo kiro-cli ;;
    *)        echo "" ;;
  esac
}

installing=false
if [[ ${1:-} == "--install" ]]; then
  # Set when this script re-execs itself in a terminal; see the guard below.
  installing=true
  shift
fi

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  # Silent when unset rather than defaulting: Omarchy picks no agent for you, so
  # the menu leaves every entry unchecked until one is chosen.
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

case "$1" in
pi) agent="pi"; name="Pi" ;;
omp | oh-my-pi) agent="omp"; name="Oh My Pi" ;;
opencode | open-code) agent="opencode"; name="OpenCode" ;;
claude | claude-code) agent="claude"; name="Claude Code" ;;
codex) agent="codex"; name="Codex" ;;
crush) agent="crush"; name="Crush" ;;
grok) agent="grok"; name="Grok" ;;
# quattro names it agy, its command; antigravity is the id stable stored.
agy | antigravity | antigravity-cli) agent="agy"; name="Antigravity" ;;
# Omarchy 4.5's omarchy-agent has no gemini case. Keep the old name as an alias
# for Antigravity so existing choices still launch an agent.
gemini | gemini-cli) agent="agy"; name="Antigravity" ;;
copilot | github-copilot) agent="copilot"; name="GitHub Copilot" ;;
# The menu has rows for these four and the case did not, so each printed a usage
# line and exited 1 -- into a detached terminal nobody sees (#949).
cursor-agent | cursor) agent="cursor-agent"; name="Cursor Agent" ;;
hermes) agent="hermes"; name="Hermes" ;;
muse) agent="muse"; name="Muse" ;;
openclaw) agent="openclaw"; name="OpenClaw" ;;
ori | openrouter) agent="ori"; name="Ori" ;;
kimi | kimi-code) agent="kimi"; name="Kimi" ;;
# quattro 1381fa0's menu rows (#14040), with upstream's aliases (#1447).
qwen | qwen-code) agent="qwen"; name="Qwen Code" ;;
dsh | deepseek | deepseek-harness) agent="dsh"; name="DeepSeek Harness" ;;
mcode | minimax-code | minimax) agent="mcode"; name="MiniMax Code" ;;
kiro-cli | kiro) agent="kiro-cli"; name="Kiro CLI" ;;
freebuff) agent="freebuff"; name="Freebuff" ;;
kilo | kilocode | kilo-code) agent="kilo"; name="Kilo" ;;
devin | devin-cli) agent="devin"; name="Devin CLI" ;;
amp | ampcode) agent="amp"; name="Amp" ;;
commandcode | command-code | cmdc) agent="commandcode"; name="Command Code" ;;
*)
  echo "Usage: omarchy-default-agent <claude|codex|opencode|crush|gemini|copilot|grok|agy|pi|omp|cursor-agent|hermes|muse|openclaw|ori|kimi|qwen|dsh|mcode|kiro-cli|freebuff|kilo|devin|amp|commandcode>" >&2
  exit 1
  ;;
esac

record() {
  mkdir -p "$(dirname "$agent_file")"
  printf '%s\n' "$agent" >"$agent_file"
}

# gum confirm has three answers, not two: 0 is yes, 1 is no, 130 is a quit --
# and anything else means it could not ask at all. The usual `gum confirm ... ||`
# collapses the last two into "no", which is how an offer to build silently did
# nothing at all when there was no terminal to draw on.
#
# So the caller says what "could not ask" should mean, rather than inheriting
# whichever answer the shell's error convention happens to match.
confirm() { # confirm <prompt> <yes|no, when it cannot be asked>
  local prompt=$1 fallback=$2 rc

  if [ -t 0 ] && [ -t 1 ] && command -v gum &>/dev/null; then
    gum confirm "$prompt"
    rc=$?
    case $rc in
      0) return 0 ;;
      1) return 1 ;;
      130) exit 130 ;; # a quit is a quit; the presentation wrapper reads this
      *) ;;            # could not ask -- fall through
    esac
  fi

  [ "$fallback" = yes ]
}

# A shell opened before mise left keeps its directories on PATH, where a dead shim would
# read as an installed agent. PATH rather than the one test, because omarchy-agent
# inherits it. A mise inside installs/ cannot vouch for itself.
stale=false
live_path=""
IFS=: read -ra path_entries <<<"$PATH"
for entry in "${path_entries[@]}"; do
  case $entry in
    */mise/shims | */mise/installs/* | */mise/command-wrappers/*) stale=true ;;
    *) live_path+=${live_path:+:}$entry ;;
  esac
done
if [[ $stale == true ]] && ! PATH=$live_path command -v mise &>/dev/null; then
  export PATH=$live_path
fi

# The command each agent installs is its own id. Checked against PATH rather
# than against a package database: what matters is whether omarchy-agent will
# find it, and that is the same question.
agent_cmd=$agent
if PATH=$(omarchy-agent-real-path) command -v "$agent_cmd" &>/dev/null; then
  record
  exec omarchy-agent
fi

# A menu row runs this with no terminal, so every route below would print to nowhere.
if [[ $installing == false && ! -t 1 ]]; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-default-agent --install "$agent"
fi

attr=$(attr_for "$agent")

if [[ -n $attr ]]; then
  echo
  echo "$name is not installed."
  echo
  echo "Adding it to your configuration as ${attr}, so it is still here after"
  echo "the next rebuild and on the next machine you install from this flake."
  echo

  if ! nixarchy-pkg-add "$attr"; then
    echo >&2
    echo "Could not add $attr to ~/.config/nixarchy/apps.nix." >&2
    echo "Add it by hand and run: nixarchy apply" >&2
    exit 1
  fi

  # Recorded before the rebuild, so the answer survives closing the terminal during it,
  # and after the add, so a failed add does not replace a working default.
  record

  echo
  echo "Building it now. This takes a few minutes the first time, and asks for"
  echo "your password to rebuild the system."
  echo

  # Run, not offered. Choosing an agent and getting one used to be the same act
  # -- upstream installs it there and then -- and splitting them is what left a
  # ticked menu entry beside a `claude: command not found`. Declining is still
  # possible, and says what it costs.
  #
  # "yes" when it cannot ask: a menu row has its terminal by now, so the cases
  # that cannot are scripts and tests, where finishing the job beats stopping
  # half way through it.
  if confirm "Build it now?" yes; then
    exec nixarchy-apply
  fi

  echo "Not building. $name is in your configuration but not installed yet."
  echo "Run 'nixarchy apply' when you are ready."
  exit 0
fi

# Packaged elsewhere, and named rather than carried (#949).
#
# numtide/llm-agents.nix has all six. It is NOT a nixarchy input and must not
# become one: lib.inputSources collects every flake's outPath and every input of
# theirs transitively, and installer/cd.nix and installer/host.nix both carry
# that onto the network ISO and every installed host. llm-agents.nix pins its
# own nixpkgs-unstable and documents being tested only against it, so `follows`
# is not safely available -- one nixpkgs source tree measures about 486 MB, and
# checks.iso-budget exists to refuse it.
#
# The reason is printed, not just recorded here: without it the next person
# reads "packaged over there" as "so add the input".
elsewhere_attr_for() {
  case "$1" in
    kimi)        echo kimi-code ;;
    mcode)       echo minimax-code ;;
    freebuff)    echo freebuff ;;
    commandcode) echo command-code ;;
    ori)         echo ori ;;
    hermes)      echo hermes-agent ;;
    *)           echo "" ;;
  esac
}

elsewhere=$(elsewhere_attr_for "$agent")
if [[ -n $elsewhere ]]; then
  current=""
  if [[ -f $agent_file ]]; then
    read -r current <"$agent_file"
  fi

  echo
  echo "$name is not installed, and nixarchy does not install it."
  if [[ -n $current ]]; then
    echo "Your default agent is unchanged: $current."
  else
    echo "No default agent is set."
  fi
  echo
  echo "It is not in nixpkgs. numtide/llm-agents.nix packages it as $elsewhere. Add that"
  echo "flake as an input and the package to your configuration, rebuild, and choose it"
  echo "again."
  echo
  echo "nixarchy does not carry it: llm-agents.nix pins its own nixpkgs, and nixarchy puts"
  echo "every input's source tree on the ISO and on every installed machine -- about"
  echo "486 MB, for one optional agent."
  if [[ $agent == commandcode ]]; then
    echo
    echo "Note: Command Code is unfree wherever it comes from, so a machine with"
    echo "nixpkgs.config.allowUnfree = false cannot install it at all."
  fi
  echo
  exit 1
fi

echo "No way to install $name is known." >&2
exit 1
