#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2153,SC2154 # Generated scripts keep $HOME literal; Nix supplies the fixture and out variables.
set -euo pipefail

fixture_a=$FIXTURE_A
fixture_c=$FIXTURE_C
script=$MIGRATE_SCRIPT
oracle=$ORACLE_SOURCE
work=$PWD/cases
mkdir -p "$work"

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
marker_count() {
  local state=$HOME/.local/state/omarchy/migrations
  if [[ -d $state ]]; then
    find "$state" -maxdepth 1 -name '*.sh' | wc -l
  else
    printf '0\n'
  fi
}
assert_markers() { [[ $(marker_count) -eq $1 ]] || fail "$case: expected $1 markers, found $(marker_count)"; }
normalise() {
  jq -S '
    .bar.layout as $layout
    | .bar.layout = (["left","centerBegin","center","centerEnd","right","tray"] | map({key:., value:($layout[.] // [])}) | from_entries)
    | .plugins //= [] | del(.version, .bar.centerAnchor)
  ' "$1" > "$2"
}
setup() {
  local name=$1 fixture=$2
  export HOME="$work/$name"
  export XDG_CONFIG_HOME="$HOME/.config" XDG_STATE_HOME="$HOME/.local/state"
  export XDG_DATA_HOME="$HOME/.local/share" XDG_CACHE_HOME="$HOME/.cache"
  export OMARCHY_MIGRATION_STATE="$HOME/.local/state/omarchy/migrations"
  mkdir -p "$XDG_CONFIG_HOME/omarchy" "$XDG_STATE_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"
  cp "$fixture" "$XDG_CONFIG_HOME/omarchy/shell.json"
  : > "$HOME/ipc.log"
  : > "$HOME/journal.log"
}
run_port() { bash "$script"; }
run_oracle() {
  bash "$oracle/migrations/1790042972.sh"
  bash "$oracle/migrations/1791968925.sh"
  bash "$oracle/migrations/1791969355.sh"
}
snapshot() {
  local dir=$1
  (
    cd "$dir"
    find . -printf '%y %p %l\n' | sort
    find . -type f -print0 | sort -z | xargs -0 -r sha256sum
  )
}
same_tree() { diff -u <(snapshot "$1") <(snapshot "$2"); }
oracle_run() {
  local id=$1 fixture=$2
  setup "$case.oracle.$id" "$FIXTURE_C"
  cp -a "$fixture"/. "$HOME"/
  OMARCHY_PATH=$ORACLE_SOURCE bash -euo pipefail "$ORACLE_SOURCE/migrations/$id.sh"
}
case_fresh45() {
  local before id script
  case=fresh45
  setup fresh45 "$FIXTURE_C"
  mkdir -p "$XDG_STATE_HOME/omarchy/notifications" \
    "$XDG_STATE_HOME/omarchy/workspace-layouts" \
    "$XDG_CONFIG_HOME/herdr" "$XDG_DATA_HOME/applications" \
    "$OMARCHY_MIGRATION_STATE"
  printf '%s\n' '[]' > "$XDG_STATE_HOME/omarchy/notifications/live.json"
  printf '%s\n' '[]' > "$XDG_STATE_HOME/omarchy/notifications/history.json"
  printf '%s\n' '{"dnd":false}' > "$XDG_STATE_HOME/omarchy/notifications/quiet.json"
  printf '%s\n' 'o.workspace_mode({ workspace = "3", mode = "scrolling" })' > "$XDG_STATE_HOME/omarchy/workspace-layouts/3.lua"
  printf '%s\n' 'panel_bg = "reset"' 'surface_dim = "black"' > "$XDG_CONFIG_HOME/herdr/config.toml"
  printf '%s\n' '[Desktop Entry]' 'StartupWMClass=omarchy' > "$XDG_DATA_HOME/applications/omarchy.desktop"
  mkdir -p "$XDG_CONFIG_HOME/imv"
  printf '%s\n' 'user-owned imv config' > "$XDG_CONFIG_HOME/imv/managed-config"
  ln -s managed-config "$XDG_CONFIG_HOME/imv/config"
  for id in 1790042972 1791968925 1791969355; do
    touch "$OMARCHY_MIGRATION_STATE/$id.sh"
  done
  while IFS=$'\t' read -r id script; do
    [[ -n $id && -n $script ]] || fail 'fresh45: invalid list entry'
    touch "$OMARCHY_MIGRATION_STATE/$id.sh"
  done < "$NIXARCHY_USER_MIGRATIONS/list"
  before=$work/fresh45.before
  mkdir -p "$before"
  cp -a "$HOME"/. "$before"/
  run_port
  same_tree "$before" "$HOME" || fail 'fresh45: runner changed a seeded home'
  [[ -L $XDG_CONFIG_HOME/imv/config ]] || fail 'fresh45: managed symlink replaced'
  [[ $(marker_count) -eq $((3 + $(wc -l < "$NIXARCHY_USER_MIGRATIONS/list"))) ]] || fail 'fresh45: markers missing'
}
case_1673() {
  local layouts before
  case=1673
  setup 1673 "$FIXTURE_C"
  layouts=$XDG_STATE_HOME/omarchy/workspace-layouts
  mkdir -p "$layouts"
  printf '%s\n' 'hl.workspace_rule({ workspace = "-98", layout = "scrolling" })' > "$layouts/-98.lua"
  printf '%s\n' 'hl.workspace_rule({ workspace = "3", layout = "scrolling" })' > "$layouts/3.lua"

  run_port
  [[ -e $OMARCHY_MIGRATION_STATE/1787679775.sh && -e $OMARCHY_MIGRATION_STATE/1791698594.sh ]] || fail '1673: migration markers missing'
  [[ ! -e $layouts/-98.lua ]] || fail '1673: named workspace layout remains'
  printf '%s\n' 'o.workspace_mode({ workspace = "3", mode = "scrolling" })' | cmp - "$layouts/3.lua" || fail '1673: workspace mode not saved'
  [[ $(cat "$HOME/calls.log") == 'hyprctl reload' ]] || fail '1673: expected one Hyprland reload'

  before=$work/1673.before-second-run
  mkdir -p "$before"
  cp -a "$HOME"/. "$before"/
  run_port
  same_tree "$before" "$HOME" || fail '1673: second run changed the home'
}
case_1674() {
  local current staged toggles remembered before webp renamed source
  case=1674
  setup 1674 "$FIXTURE_C"
  current=$XDG_STATE_HOME/omarchy/current
  staged=$current/theme/backgrounds
  toggles=$XDG_STATE_HOME/omarchy/toggles/hypr
  remembered=$XDG_STATE_HOME/omarchy/theme-backgrounds
  mkdir -p "$staged" "$toggles" "$remembered" "$XDG_CONFIG_HOME/hypr"
  printf '%s\n' catppuccin > "$current/theme.name"
  ln -s "$staged/1-totoro.jpg" "$current/background"
  printf '%s\n' "$staged/1-totoro.jpg" > "$remembered/catppuccin"
  printf '%s\n' "$staged/0-winding-road.jpg" > "$remembered/tokyo-night"
  printf '%s\n' 'hl.config({ animations = { enabled = false } })' \
    'o.window(".*", { opacity = "1 1" })' > "$toggles/no-animations.lua"
  printf '%s\n' '-- existing look and feel' > "$XDG_CONFIG_HOME/hypr/looknfeel.lua"
  : > "$HOME/calls.log"

  OMARCHY_SESSION_ID=fixture-session run_port
  for id in 1788281348 1791470456 1791705142 1792259038; do
    [[ -e $OMARCHY_MIGRATION_STATE/$id.sh ]] || fail "1674: marker missing for $id"
  done
  [[ ! -e $OMARCHY_MIGRATION_STATE/1791123731.sh ]] || fail '1674: declined example ran'
  [[ $(<"$current/background-intro.session-id") == fixture-session ]] || fail '1674: intro session was not recorded'
  webp=$staged/1-totoro.webp
  [[ $(readlink "$current/background") == "$webp" ]] || fail '1674: active background was not repaired'
  source=$OMARCHY_PATH/themes/catppuccin/backgrounds/1-totoro.webp
  cmp "$source" "$webp" || fail '1674: bundled WebP was not staged'
  [[ $(<"$remembered/catppuccin") == "$webp" ]] || fail '1674: remembered JPG was not repaired'
  renamed=$staged/1-winding-road.webp
  cmp "$OMARCHY_PATH/themes/tokyo-night/backgrounds/1-winding-road.webp" "$renamed" || fail '1674: renamed background was not staged'
  [[ $(<"$remembered/tokyo-night") == "$renamed" ]] || fail '1674: renumbered selection was not repaired'
  [[ $(<"$toggles/no-animations.lua") == 'hl.config({ animations = { enabled = false } })' ]] || fail '1674: animation flag still forces opacity'
  cmp "$OMARCHY_PATH/default/hypr/toggles/window-opaque.lua" "$toggles/window-opaque.lua" || fail '1674: opaque toggle missing'
  [[ $(<"$XDG_CONFIG_HOME/hypr/looknfeel.lua") == '-- existing look and feel' ]] || fail '1674: declined example changed looknfeel'
  printf '%s\n' 'omarchy-theme-refresh ' "omarchy-shell background set $webp" > "$work/1674.expected-calls"
  cmp "$work/1674.expected-calls" "$HOME/calls.log" || fail '1674: unexpected session calls'

  before=$work/1674.before-second-run
  mkdir -p "$before"
  cp -a "$HOME"/. "$before"/
  OMARCHY_SESSION_ID=fixture-session run_port
  same_tree "$before" "$HOME" || fail '1674: second run changed the home'
}
case_1675() {
  local applications before
  case=1675
  setup 1675 "$FIXTURE_C"
  applications=$XDG_DATA_HOME/applications
  mkdir -p "$applications"
  printf '%s\n' '[Desktop Entry]' 'Name=Example' \
    'Exec=omarchy-launch-webapp "https://example.com/dashboard"' \
    'Terminal=false' > "$applications/example.desktop"
  printf '%s\n' '[Desktop Entry]' 'Name=HEY' \
    'Exec=omarchy-webapp-handler-hey %u' > "$applications/hey.desktop"
  printf '%s\n' '[Desktop Entry]' 'Name=Existing' \
    'Exec=omarchy-launch-webapp "https://already.example"' \
    'StartupWMClass=existing-class' > "$applications/existing.desktop"
  printf '%s\n' '[Desktop Entry]' 'Name=Custom' \
    'Exec=custom-browser https://custom.example' > "$applications/custom.desktop"
  : > "$HOME/calls.log"

  run_port
  for id in 1791696584 1791875754; do
    [[ -e $OMARCHY_MIGRATION_STATE/$id.sh ]] || fail "1675: marker missing for $id"
  done
  printf '%s\n' '[Desktop Entry]' 'Name=Example' \
    'Exec=omarchy-launch-webapp "https://example.com/dashboard"' \
    'StartupWMClass=chrome-example.com__dashboard-Default' \
    'Terminal=false' > "$work/1675.expected-example.desktop"
  cmp "$work/1675.expected-example.desktop" "$applications/example.desktop" || fail '1675: standard launcher class or placement wrong'
  printf '%s\n' '[Desktop Entry]' 'Name=HEY' \
    'Exec=omarchy-webapp-handler-hey %u' \
    'StartupWMClass=chrome-app.hey.com__-Default' > "$work/1675.expected-hey.desktop"
  cmp "$work/1675.expected-hey.desktop" "$applications/hey.desktop" || fail '1675: HEY launcher class or placement wrong'
  printf '%s\n' '[Desktop Entry]' 'Name=Existing' \
    'Exec=omarchy-launch-webapp "https://already.example"' \
    'StartupWMClass=existing-class' > "$work/1675.expected-existing.desktop"
  cmp "$work/1675.expected-existing.desktop" "$applications/existing.desktop" || fail '1675: existing class changed'
  printf '%s\n' '[Desktop Entry]' 'Name=Custom' \
    'Exec=custom-browser https://custom.example' > "$work/1675.expected-custom.desktop"
  cmp "$work/1675.expected-custom.desktop" "$applications/custom.desktop" || fail '1675: unrelated launcher changed'
  printf '%s\n' \
    'omarchy-webapp-window-class https://example.com/dashboard' \
    'omarchy-webapp-window-class https://app.hey.com' > "$work/1675.expected-calls"
  cmp "$work/1675.expected-calls" "$HOME/calls.log" || fail '1675: unexpected window class calls'

  before=$work/1675.before-second-run
  mkdir -p "$before"
  cp -a "$HOME"/. "$before"/
  run_port
  same_tree "$before" "$HOME" || fail '1675: second run changed the home'
}
case_runner_stop() {
  local list_dir=$work/runner-list
  case=runner-stop
  setup runner-stop "$FIXTURE_C"
  mkdir -p "$list_dir"
  printf '%s\n' 'exit 1' > "$list_dir/first.sh"
  printf '%s\n' 'printf "%s\\n" second >> "$HOME/order"' > "$list_dir/second.sh"
  printf '%s\t%s\n' 100 "$list_dir/first.sh" 200 "$list_dir/second.sh" > "$list_dir/list"
  NIXARCHY_USER_MIGRATIONS=$list_dir
  export NIXARCHY_USER_MIGRATIONS
  if run_port; then fail 'runner-stop: first failure returned success'; fi
  [[ ! -e $HOME/order && ! -d $OMARCHY_MIGRATION_STATE ]] || fail 'runner-stop: continued after failure'
  grep -F '100: user migration failed' "$HOME/journal.log" >/dev/null || fail 'runner-stop: journal lacks failed id'
  # It drains stdin: with the list on stdin, the second entry would vanish.
  printf '%s\n' 'cat >/dev/null; printf "%s\\n" first >> "$HOME/order"' > "$list_dir/first.sh"
  run_port
  [[ $(cat "$HOME/order") == $'first\nsecond' ]] || fail 'runner-stop: recovery order wrong'
  [[ -e $OMARCHY_MIGRATION_STATE/100.sh && -e $OMARCHY_MIGRATION_STATE/200.sh ]] || fail 'runner-stop: recovery markers missing'
}
compare_oracle() {
  local fixture=$1
  normalise "$XDG_CONFIG_HOME/omarchy/shell.json" "$work/$case.actual.json"
  setup "$case.oracle" "$fixture"
  run_oracle
  normalise "$XDG_CONFIG_HOME/omarchy/shell.json" "$work/$case.oracle.json"
  diff -u "$work/$case.oracle.json" "$work/$case.actual.json" || fail "$case differs from upstream"
}
case_a() {
  case=a
  setup a "$fixture_a"
  run_port
  assert_markers 3
  jq -e '.bar.layout.centerEnd[0].id == "omarchy.elsewhen"' "$XDG_CONFIG_HOME/omarchy/shell.json" >/dev/null || fail 'a: Elsewhen is not first in centerEnd'
  compare_oracle "$fixture_a"
  cp "$work/a.actual.json" "$out"
}

case_a
[[ ${1:-} == expected ]] && exit 0
cmp "$out" "$EXPECTED_A" || fail 'a: expectedA differs from check result'

case=b
jq '.bar.layout.centerBegin = [{id:"local.before"}] | .bar.layout.centerEnd = [{id:"local.after"}] | .bar.layout.center = [{id:"local.one"}] + .bar.layout.center + [{id:"local.two"}] | .bar.layout.right = [{id:"local.right"}] + .bar.layout.right' "$fixture_a" > "$work/b.fixture.json"
setup b "$work/b.fixture.json"
run_port
compare_oracle "$work/b.fixture.json"

case=c
setup c "$fixture_c"
run_port
cmp "$fixture_c" "$XDG_CONFIG_HOME/omarchy/shell.json" || fail 'c: new seed changed'
[[ ! -s $HOME/ipc.log && ! -d $OMARCHY_MIGRATION_STATE ]] || fail 'c: IPC or markers on new seed'

case=d
jq '.bar.id = "local.neon-bar"' "$fixture_a" > "$work/d.fixture.json"
setup d "$work/d.fixture.json"
run_port
assert_markers 1
[[ $(grep -cE 'putBarWidget|moveBarWidget' "$HOME/ipc.log" || true) -eq 1 ]] || fail 'd: unexpected layout call'
grep 'putBarWidget omarchy.elsewhen' "$HOME/ipc.log" >/dev/null || fail 'd: Elsewhen put missing'
compare_oracle "$work/d.fixture.json"

case=e
setup e "$fixture_a"
run_port
cfg=$XDG_CONFIG_HOME/omarchy/shell.json
jq '.bar.layout |= with_entries(.value |= map(select(.id != "omarchy.elsewhen")))' "$cfg" > "$cfg.tmp"
mv "$cfg.tmp" "$cfg"
: > "$HOME/ipc.log"
run_port
jq -e '[.bar.layout[]?[]? | .id] | index("omarchy.elsewhen") == null' "$cfg" >/dev/null || fail 'e: Elsewhen restored despite marker'
[[ ! -s $HOME/ipc.log ]] || fail 'e: second run made IPC calls'

case=f
setup f "$fixture_a"
STUB_NOWRITE=1 run_port
assert_markers 0
[[ -s $HOME/journal.log ]] || fail 'f: missing journal line'
run_port
assert_markers 3
normalise "$XDG_CONFIG_HOME/omarchy/shell.json" "$work/f.actual.json"
diff -u "$EXPECTED_A" "$work/f.actual.json" || fail 'f: recovery differs from a'

case=g
jq '.bar.layout.right += [.bar.layout.center[1]] | .bar.layout.center |= del(.[1])' "$fixture_a" > "$work/g.fixture.json"
setup g "$work/g.fixture.json"
run_port
assert_markers 3
[[ $(grep -c 'moveBarWidget' "$HOME/ipc.log" || true) -eq 0 ]] || fail 'g: moved with missing anchor'
compare_oracle "$work/g.fixture.json"

case=h
jq '.bar.layout.right = [{id:"omarchy.tray",t:1},{id:"local.x"},{id:"omarchy.tray",t:2}]' "$fixture_a" > "$work/h.fixture.json"
setup h "$work/h.fixture.json"
run_port
[[ -e $OMARCHY_MIGRATION_STATE/1791968925.sh ]] || fail 'h: tray marker missing'
jq -e '.bar.layout.right == [{id:"omarchy.tray",t:2},{id:"omarchy.tray",t:1},{id:"local.x"}]' "$XDG_CONFIG_HOME/omarchy/shell.json" >/dev/null || fail 'h: duplicate tray order wrong'

case=drift
setup drift "$fixture_a"
STUB_DRIFT=1 run_port
[[ ! -e $OMARCHY_MIGRATION_STATE/1791969355.sh ]] || fail 'drift: split marker despite refused move'
grep 'widget at center\[0\] is not omarchy.indicators' "$HOME/journal.log" >/dev/null || fail 'drift: refusal not observed'
case_fresh45
case_1673
case_1674
case_1675
case_runner_stop
printf '%s\n' 'user migrations: all cases passed'
