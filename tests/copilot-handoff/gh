#!/usr/bin/env bash
# Stub `gh` for checks.copilot-handoff (tests/copilot-handoff.nix). Dispatches
# on the whole argument line, since the real copilot-handoff.sh runs `gh`
# with a different --json/-q combination for each call it makes.
set -euo pipefail
args="$*"

case "$args" in
  *"--json jobs"*)
    # Apply the caller's -q to a jobs fixture, so a change to the script's
    # jq filter changes what this prints (#1341).
    q=""
    prev=""
    for a in "$@"; do
      [ "$prev" = "-q" ] && q="$a"
      prev="$a"
    done
    jobs=${GH_JOBS:-'[{"name":"system-checks","conclusion":"failure"}]'}
    jq -n -c --argjson jobs "$jobs" '{jobs: $jobs}' | jq -r "$q"
    ;;
  *"pr list "*)
    printf '%s\n' "1154"
    ;;
  *"--json headSha"*)
    printf '%s\n' "deadbeef"
    ;;
  *"--json comments"*)
    printf '%s\n' "[]"
    ;;
  *"--log-failed"*)
    # 20 000 lines (~1.3 MB): far more than any pipe buffer between the stages,
    # so they are still writing when `head -100` exits and SIGPIPE is certain
    # under pipefail (#1157). 500 lines fit in a buffer and raced (#1381).
    for i in $(seq 1 20000); do
      printf 'system\tDrive a session\t2026-10-02T00:00:00.0000000Z error: line %d\n' "$i"
    done
    ;;
  *)
    echo "copilot-handoff/gh stub: unexpected call: $args" >&2
    exit 3
    ;;
esac
