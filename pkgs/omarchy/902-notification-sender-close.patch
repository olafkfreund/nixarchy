# nixarchy #1032 / #1380: a critical notification its SENDER closes leaves the screen.
# Quattro's new engine never expires a critical card, so CloseNotification left it up for good;
# narrowed to critical cards, every other card keeps upstream's rule. Drop when upstream fixes it.
diff --git a/shell/plugins/notifications/Service.qml b/shell/plugins/notifications/Service.qml
index 1595fc94..0fd283d4 100644
--- a/shell/plugins/notifications/Service.qml
+++ b/shell/plugins/notifications/Service.qml
@@ -878,13 +878,17 @@ Item {
 
   function watchNotification(notification, key) {
     var reservation = liveKeys[key]
-    notification.closed.connect(function() {
+    notification.closed.connect(function(reason) {
       if (service.refs[key] !== notification) return
       delete service.refs[key]
       service.refsRevision += 1
       // Visible snapshots outlive their sender; pending rows must not appear
       // after the sender withdraws them.
       if (service.rowIndexFor(key) < 0) service.finishClose(key, "closed")
+      // nixarchy #1032: a critical card never expires, so one its sender
+      // withdrew stayed on screen for good; take that one down, the rest keep upstream's rule.
+      else if (reason === NotificationCloseReason.CloseRequested && notification.urgency === NotificationUrgency.Critical)
+        service.closeToast(key, "closed")
     })
     // NotificationServer emits onNotification only for new objects. A
     // replaces_id update mutates this QObject and emits its property signals,
