run_port
cmp "$fixture_c" "$XDG_CONFIG_HOME/omarchy/shell.json" || fail 'c: new seed changed'
[[ ! -s $HOME/ipc.log && ! -d $OMARCHY_MIGRATION_STATE ]] || fail 'c: IPC or markers on new seed'

case=d
jq '.bar.id = "local.neon-bar"' "$fixture_a" > "$work/d.fixture.json"
setup d "$work/d.fixture.json"
run_port
assert_markers 1
[[ $(grep -cE 'putBarWidget|moveBarWidget' "$HOME/ipc.log" || true) -eq 1 ]] || fail 'd: unexpected layout call'
grep 'putBarWidget omarchy.elsewhen' "$HOME/ipc.log" >/dev/null || fail 'd: Elsewhen put missing'
compare_oracle "$work/d.fixture.json"

case=e
