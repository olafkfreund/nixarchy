#!/usr/bin/env bash
# eval --raw .#<attr>.drvPath from common/drvs; log <drv> from log/<drv basename>.
set -eu
case $1 in
  eval)
    [ "$2" = --raw ] || exit 2
    attr=${3#.#}
    attr=${attr%.drvPath}
    awk -v a="$attr" '$1 == a { printf "%s", $2; found = 1 } END { exit !found }' "$STUB_COMMON/drvs" ;;
  log)
    for arg in "$@"; do
      if [[ $arg == *substituters* ]]; then local_only=1; fi
    done
    base=${!#}; base=${base##*/}
    for d in "$STUB_CASE/log" "$STUB_CASE/old-log" "$STUB_COMMON/log"; do
      if [ -f "$d/$base" ]; then cat "$d/$base"; exit 0; fi
    done
    if [ "${local_only:-0}" -ne 1 ] && [ -f "$STUB_CASE/remote-log/$base" ]; then
      cat "$STUB_CASE/remote-log/$base"
      exit 0
    fi
    echo "error: no log for $base" >&2
    exit 1 ;;
  *) exit 2 ;;
esac
